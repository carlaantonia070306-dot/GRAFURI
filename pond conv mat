#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <malloc.h>

int citire_graf(char numefisier[], int* nr_vrf, int* nr_muchii, int*** g)
{
    FILE* f;

    f = fopen(numefisier, "r");
    if (f == NULL)
        return 1;

    fscanf(f, "%d %d", nr_vrf, nr_muchii);

    *g = (int**)malloc(*nr_muchii * sizeof(int*));

    for (int i = 0; i < *nr_muchii; i++)
        (*g)[i] = (int*)malloc(3 * sizeof(int));

    for (int i = 0; i < *nr_muchii; i++)
        fscanf(f, "%d %d %d", &(*g)[i][0], &(*g)[i][1], &(*g)[i][2]);

    fclose(f);
    return 0;
}

int** conversie_matrice(int nr_vrf, int nr_muchii, int** tabel, int* dim)
{
    int** mat;

    *dim = nr_vrf;

    mat = (int**)malloc(*dim * sizeof(int*));

    for (int i = 0; i < *dim; i++)
        mat[i] = (int*)malloc(*dim * sizeof(int));

    for (int i = 0; i < *dim; i++)
    {
        for (int j = 0; j < *dim; j++)
            mat[i][j] = 0;
    }

    for (int i = 0; i < nr_muchii; i++)
    {
        mat[tabel[i][0] - 1][tabel[i][1] - 1] = tabel[i][2];
        mat[tabel[i][1] - 1][tabel[i][0] - 1] = tabel[i][2];
    }

    return mat;
}

int main()
{
    char numefisier[20];
    int n, m, ** tabel, er;

    printf("Introduceti fisierul din care cititi graful: ");
    scanf("%s", numefisier);

    er = citire_graf(numefisier, &n, &m, &tabel);

    if (er != 0)
    {
        printf("Eroare la deschiderea fisierului!\n");
        return 1;
    }

    printf("Numarul de varfuri este: %d\n", n);
    printf("Numarul de muchii este: %d\n", m);

    printf("Muchiile sunt:\n");
    for (int i = 0; i < m; i++)
        printf("%d %d %d\n", tabel[i][0], tabel[i][1], tabel[i][2]);

    int** a, dim;

    a = conversie_matrice(n, m, tabel, &dim);

    printf("\nMatricea de adiacenta este:\n");
    for (int i = 0; i < dim; i++)
    {
        for (int j = 0; j < dim; j++)
            printf("%d ", a[i][j]);

        printf("\n");
    }

    for (int i = 0; i < m; i++)
        free(tabel[i]);
    free(tabel);

    for (int i = 0; i < dim; i++)
        free(a[i]);
    free(a);

    return 0;
}
