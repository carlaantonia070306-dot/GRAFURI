#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>

// citire graf ponderat
int citire_graf(char numefisier[], int* nr_vrf, int* nr_muchii, int*** g)
{
    FILE* f;

    f = fopen(numefisier, "r");
    if (f == NULL)
        return 0;

    fscanf(f, "%d %d", nr_vrf, nr_muchii);

    // alocare vector de muchii
    *g = (int**)malloc(*nr_muchii * sizeof(int*));

    // fiecare muchie are 3 valori: u, v, pondere
    for (int i = 0; i < *nr_muchii; i++)
        (*g)[i] = (int*)malloc(3 * sizeof(int));

    // citire muchii
    for (int i = 0; i < *nr_muchii; i++)
        fscanf(f, "%d %d %d",&(*g)[i][0] ,&(*g)[i][1], &(*g)[i][2]);

    fclose(f);
    return 1;
}

int main()
{
    char numefisier[20];
    int n, m, ** tabel, er;
    int i;

    printf("Introduceti fisierul din care cititi graful: ");
    scanf("%s", numefisier);

    er = citire_graf(numefisier, &n, &m, &tabel);

    if (er == 0)
    {
        printf("Eroare la deschiderea fisierului!\n");
        return 0;
    }

    printf("\nNumarul de varfuri este: %d\n", n);
    printf("Numarul de muchii este: %d\n", m);

    printf("Muchiile sunt:\n");

    for (i = 0; i < m; i++)
    {
        printf("%d %d ", tabel[i][0], tabel[i][1]);
        printf("Ponderea muchiei este: %d\n", tabel[i][2]);
    }

    // eliberare memorie
    for (i = 0; i < m; i++)
        free(tabel[i]);

    free(tabel);

    return 1;
}
